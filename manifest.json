{
  "action": {
    "default_icon": "icons/icon48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-ui": {
      "description": "Toggle FlipHelper UI",
      "suggested_key": {
        "default": "Alt+A"
      }
    }
  },
  "content_scripts": [
    {
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "matches": [
        "https://bloxflip.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "Free BloxFlip extension for balance tracking, autobet, and more.",
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "key": "",
  "manifest_version": 3,
  "name": "FlipHelper",
  "permissions": [
    "storage"
  ],
  "update_url": "https://clients2.google.com/service/update2/crx",
  "version": "1.0.1",
  "web_accessible_resources": [
    {
      "matches": [
        "https://bloxflip.com/*"
      ],
      "resources": [
        "fonts/*.woff2",
        "inject.js",
        "basic.svg",
        "chart.svg"
      ]
    }
  ]
}